+       u8 length; /* 0x14 */
+       __le16 counter; /* 0x2000 | sequence */
+       __le16 x;
+       __le16 y;
+       __le16 width;
+       __le16 height;
+       __le32 length_flags; /* payload length | (command << 28) */
+       u8 flags; /* 0x01 */
